{
  "$comment": [
    "Single source of truth for the IT-eary palette.",
    "",
    "React and Flutter share no UI code, so this file is the one place a brand",
    "colour is defined. `npm run tokens` regenerates both consumers:",
    "  src/styles/tokens.css  — a Tailwind v4 @theme block (bg-staff-ground, ...)",
    "  mobile/lib/tokens.dart — Dart constants (Tokens.staffGround, ...)",
    "",
    "Never hand-edit either generated file; edit this and regenerate.",
    "",
    "Two surfaces: the staff apps (cashier + admin) are dark so they read in a",
    "dim kitchen; the diner apps are warm cream to match the karinderya itself."
  ],

  "color": {
    "staff": {
      "ground": { "value": "#0f1410", "comment": "app background" },
      "card":   { "value": "#0a0d0a", "comment": "panels, sidebar, inputs" },
      "ink":    { "value": "#e8dfc8", "comment": "primary text on dark" },
      "accent": { "value": "#e8a84a", "comment": "primary action, active nav" }
    },

    "diner": {
      "ground": { "value": "#f4ead5", "comment": "app background" },
      "card":   { "value": "#fbf4e3", "comment": "dish cards, cart rows" },
      "ink":    { "value": "#2a1810", "comment": "primary text on cream" },
      "accent": { "value": "#c8442a", "comment": "wordmark, primary emphasis" }
    },

    "semantic": {
      "good":     { "value": "#8cc07a", "comment": "healthy stock, positive delta" },
      "alert":    { "value": "#e87a5c", "comment": "unpaid, needs attention" },
      "critical": { "value": "#c8442a", "comment": "destructive, out of stock" },
      "cash":     { "value": "#3a5a3a", "comment": "cash payment method" },
      "gcash":    { "value": "#0074e0", "comment": "GCash payment method" },
      "gcashSoft":{ "value": "#6dadff", "comment": "GCash on a dark ground" }
    },

    "receipt": {
      "paper": { "value": "#ffffff", "comment": "receipt sheet" },
      "print": { "value": "#1a1a1a", "comment": "receipt text" }
    }
  },

  "radius": {
    "sm":   { "value": "8px" },
    "md":   { "value": "14px" },
    "lg":   { "value": "20px" },
    "pill": { "value": "999px" }
  },

  "font": {
    "display": {
      "value": "Georgia, 'Iowan Old Style', 'Palatino Linotype', Palatino, serif",
      "comment": "headings and money figures"
    },
    "mono": {
      "value": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace",
      "comment": "ticket codes — must be unambiguous"
    }
  }
}
